# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# The app connects with DATABASE_URL. On Neon, use the POOLED connection string
# (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Migrations use DIRECT_URL when set. On Neon, use the DIRECT (non-pooled) string.
# For a local PostgreSQL you can leave this empty.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies: at least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Comma-separated emails that get the admin role when they sign up.
ADMIN_EMAILS=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payments (optional) ──────────────────────────────────────────────────────
# Leave empty to offer cash on delivery only. Use test keys (sk_test_...) for demos.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Scheduled cleanup (production) ───────────────────────────────────────────
# Any random string. Vercel sends it to /api/cron/cleanup, which deletes guest
# carts and wishlists older than 30 days.
CRON_SECRET=
