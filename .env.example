# ---------------------------------------------------------------
# Lumora environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or real credentials.
# ---------------------------------------------------------------

# AWS region of your DynamoDB table
LUMORA_AWS_REGION=ap-south-1

# IAM user credentials with access to the table only (see README).
# Leave both empty to use the default AWS credential chain
# (e.g. an IAM role when running on AWS).
LUMORA_AWS_ACCESS_KEY_ID=
LUMORA_AWS_SECRET_ACCESS_KEY=

# Name of the single DynamoDB table
DYNAMODB_TABLE=lumora-store

# Local development only: point the SDK at a local DynamoDB
# (npm run db:local starts one on port 8000). Leave empty in production.
DYNAMODB_ENDPOINT=

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Comma-separated emails that get the admin role when they sign up.
# Admins can create, update and delete products through the API.
ADMIN_EMAILS=

# Public URL of the deployed site (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
