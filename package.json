{
  "name": "lumora",
  "version": "1.0.0",
  "private": true,
  "description": "Lumora: a production-style full-stack e-commerce store built with Next.js, TypeScript, Tailwind CSS and AWS DynamoDB.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/local-dynamodb.ts",
    "db:create": "tsx scripts/create-table.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:create && npm run db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/lib-dynamodb": "3.1164.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "geist": "1.9.2",
    "jose": "5.10.0",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "dotenv": "16.6.1",
    "dynamo-db-local": "^11.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
